# Application
NODE_ENV=development
APP_NAME=ice-verification
APP_VERSION=1.0.0
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Web
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=ICE Verification

# Database
# Local Homebrew Postgres default: localhost:5432
# Docker Compose maps Postgres to localhost:5433 (to avoid port clashes)
DATABASE_URL=postgresql://ice:ice_secret@localhost:5432/ice_verification?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Set true to force in-memory cache/queue (useful if Redis is down)
# ICE_USE_MEMORY_INFRA=true

# Security
API_KEY_PEPPER=change-me-to-a-long-random-pepper-value-32chars
SESSION_SECRET=change-me-to-a-long-random-session-secret-32
WEBHOOK_SIGNING_TOLERANCE_SECONDS=300
JWT_SECRET=change-me-to-a-long-random-jwt-secret-32chars

# Rate limiting defaults (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Verification
VERIFICATION_CACHE_TTL_SECONDS=300
BATCH_SYNC_MAX_SIZE=20
BATCH_ASYNC_MAX_SIZE=100
DUPLICATE_WINDOW_HOURS=24

# Worker
WORKER_CONCURRENCY=5
WEBHOOK_MAX_RETRIES=8
PROVIDER_HEALTH_INTERVAL_MS=60000

# Demo
DEMO_MERCHANT_API_KEY=ice_test_demo_key_do_not_use_in_production

# Telebirr verification (public receipt + optional Ethiopia-hosted relays)
TELEBIRR_PRIMARY_RECEIPT_URL=https://transactioninfo.ethiotelecom.et/receipt/
# Comma-separated relay base URLs that append the reference.
# Needed when transactioninfo.ethiotelecom.et times out (common even inside Ethiopia).
TELEBIRR_FALLBACK_PROXIES=
TELEBIRR_PROXY_LABELS=
TELEBIRR_PROXY_KEY=
# Set true on hosts outside Ethiopia that cannot reach Ethio Telecom receipts
TELEBIRR_SKIP_PRIMARY=false
TELEBIRR_TIMEOUT_MS=18000
TELEBIRR_TOTAL_TIMEOUT_MS=25000
